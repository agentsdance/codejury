{
  "name": "opencode",
  "product": "OpenCode",
  "role": "reviewer",
  "enabled": false,
  "promptDelivery": "argv",
  "cwd": "flag",
  "argv": [
    "opencode",
    "run",
    "--dir",
    "{{worktree}}",
    "--session",
    "{{sessionId}}",
    "{{promptText}}"
  ],
  "judgeArgv": [
    "opencode",
    "run",
    "--dir",
    "{{worktree}}",
    "--auto",
    "{{promptText}}"
  ],
  "sandbox": "none",
  "sandboxNote": "no read-only flag; reviews omit --auto so reads proceed while writes await an approval a headless run cannot grant",
  "newSession": true,
  "resume": {
    "supported": true,
    "argv": [
      "opencode",
      "run",
      "--dir",
      "{{worktree}}",
      "--session",
      "{{sessionId}}",
      "{{promptText}}"
    ]
  },
  "report": "whole",
  "expectSeconds": 300,
  "install": "npm install -g opencode-ai",
  "docs": "https://opencode.ai/docs/cli"
}
