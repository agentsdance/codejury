{
  "name": "amp",
  "product": "Sourcegraph Amp",
  "role": "reviewer",
  "enabled": false,
  "promptDelivery": "argv",
  "cwd": "worktree",
  "argv": [
    "amp",
    "--no-notifications",
    "--no-ide",
    "--visibility",
    "private",
    "--execute={{promptText}}"
  ],
  "sandbox": "none",
  "sandboxNote": "execute mode auto-approves tools for both reviewer and judge; use only in trusted isolated worktrees",
  "resume": {
    "supported": false,
    "reason": "execute mode prints no thread id to resume by"
  },
  "report": "whole",
  "expectSeconds": 400,
  "install": "npm install -g @sourcegraph/amp",
  "docs": "https://ampcode.com/manual"
}
