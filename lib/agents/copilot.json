{
  "name": "copilot",
  "product": "GitHub Copilot CLI",
  "role": "reviewer",
  "enabled": false,
  "promptDelivery": "argv",
  "cwd": "worktree",
  "argv": [
    "copilot",
    "-p",
    "{{promptText}}",
    "--silent",
    "--add-dir",
    "{{worktree}}",
    "--deny-tool",
    "write",
    "--allow-tool",
    "read",
    "--allow-tool",
    "shell(git diff)",
    "--allow-tool",
    "shell(git status)",
    "--allow-tool",
    "shell(git show)",
    "--allow-tool",
    "shell(git merge-base)",
    "--allow-tool",
    "shell(git log)",
    "--allow-tool",
    "shell(git rev-parse)"
  ],
  "judgeArgv": [
    "copilot",
    "-p",
    "{{promptText}}",
    "--silent",
    "--add-dir",
    "{{worktree}}",
    "--allow-all-tools"
  ],
  "sandbox": "tools",
  "sandboxNote": "reviewer denies write tools and allows read plus Git inspection; trusted local CLI configuration still applies",
  "resume": {
    "supported": false,
    "reason": "fresh conversation with finding context; no session ids inferred from assistant prose"
  },
  "report": "whole",
  "expectSeconds": 400,
  "install": "npm install -g @github/copilot",
  "docs": "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-programmatic-reference",
  "env": {
    "COPILOT_ALLOW_ALL": "false"
  },
  "judgeEnv": {
    "COPILOT_ALLOW_ALL": "false"
  }
}
