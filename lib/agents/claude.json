{
  "name": "claude",
  "product": "Anthropic Claude Code",
  "role": "reviewer",
  "promptDelivery": "argv",
  "cwd": "worktree",
  "argv": [
    "claude",
    "{{modelArgs}}",
    "-p",
    "{{promptText}}",
    "--session-id",
    "{{sessionId}}",
    "--permission-mode",
    "plan",
    "--disallowedTools",
    "Edit,Write,NotebookEdit",
    "--add-dir",
    "{{worktree}}"
  ],
  "judgeArgv": [
    "claude",
    "{{modelArgs}}",
    "-p",
    "{{promptText}}",
    "--permission-mode",
    "acceptEdits",
    "--add-dir",
    "{{worktree}}"
  ],
  "sandbox": "plan",
  "sandboxNote": "reviews run in plan mode with Edit, Write and NotebookEdit withheld",
  "resume": {
    "supported": true,
    "argv": [
      "claude",
      "{{modelArgs}}",
      "-p",
      "{{promptText}}",
      "--resume",
      "{{sessionId}}",
      "--permission-mode",
      "plan",
      "--disallowedTools",
      "Edit,Write,NotebookEdit",
      "--add-dir",
      "{{worktree}}"
    ]
  },
  "modelArgs": [
    "--model",
    "{{model}}"
  ],
  "report": "whole",
  "expectSeconds": 900,
  "install": "npm install -g @anthropic-ai/claude-code",
  "docs": "https://docs.claude.com/en/docs/claude-code/cli-reference",
  "newSession": true
}
