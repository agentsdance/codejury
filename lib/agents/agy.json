{
  "name": "agy",
  "product": "Google Antigravity",
  "role": "reviewer",
  "promptDelivery": "argv",
  "cwd": "worktree",
  "argv": [
    "agy", "--dangerously-skip-permissions", "--add-dir", "{{worktree}}",
    "--print-timeout", "20m", "--print", "{{promptText}}"
  ],
  "sandbox": "none",
  "sandboxNote": "--dangerously-skip-permissions approves every tool, including writes",
  "resume": { "supported": false, "reason": "print mode starts a fresh session per run" },
  "report": "whole",
  "expectSeconds": 420,
  "install": "npm install -g @google/antigravity-cli",
  "docs": "https://antigravity.google/docs/cli"
}
