{
  "name": "droid",
  "product": "Factory Droid",
  "role": "reviewer",
  "promptDelivery": "file",
  "cwd": "flag",
  "argv": [
    "droid",
    "exec",
    "--cwd",
    "{{worktree}}",
    "--auto",
    "medium",
    "-o",
    "json",
    "-f",
    "{{promptFile}}"
  ],
  "sandbox": "plan",
  "sandboxNote": "--auto medium withholds destructive actions but permits edits",
  "resume": {
    "supported": true,
    "argv": [
      "droid",
      "exec",
      "--cwd",
      "{{worktree}}",
      "--auto",
      "medium",
      "-o",
      "json",
      "-s",
      "{{sessionId}}",
      "-f",
      "{{promptFile}}"
    ],
    "idFrom": "\"session_id\"\\s*:\\s*\"([^\"]+)\""
  },
  "modelNote": "no per-run model flag verified for this CLI yet; set its model in the CLI's own configuration",
  "report": "result-json",
  "expectSeconds": 130,
  "install": "curl -fsSL https://app.factory.ai/cli | sh",
  "docs": "https://docs.factory.ai/cli/getting-started/quickstart"
}
