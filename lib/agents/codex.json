{
  "name": "codex",
  "product": "OpenAI Codex",
  "role": "main",
  "promptDelivery": "argv",
  "cwd": "worktree",
  "argv": ["codex", "exec", "{{modelArgs}}", "--sandbox", "read-only", "--skip-git-repo-check", "--json", "{{promptText}}"],
  "judgeArgv": ["codex", "exec", "{{modelArgs}}", "--sandbox", "workspace-write", "--skip-git-repo-check", "--json", "{{promptText}}"],
  "sandbox": "sandbox",
  "sandboxNote": "reviews run under --sandbox read-only; judging uses workspace-write",
  "resume": {
    "supported": true,
    "argv": ["codex", "exec", "--sandbox", "read-only", "resume", "{{modelArgs}}", "--json", "{{sessionId}}", "{{promptText}}"],
    "judgeArgv": ["codex", "exec", "--sandbox", "workspace-write", "resume", "{{modelArgs}}", "--json", "{{sessionId}}", "{{promptText}}"],
    "idFromEvent": { "type": "thread.started", "field": "thread_id" }
  },
  "modelArgs": ["--model", "{{model}}"],
  "report": "codex-json",
  "expectSeconds": 1100,
  "install": "npm install -g @openai/codex",
  "docs": "https://developers.openai.com/codex/cli"
}
