{
  "name": "kimi",
  "product": "Moonshot Kimi CLI",
  "role": "reviewer",
  "enabled": false,
  "promptDelivery": "argv",
  "cwd": "flag",
  "argv": [
    "kimi",
    "--quiet",
    "--work-dir",
    "{{worktree}}",
    "--prompt",
    "{{promptText}}"
  ],
  "sandbox": "none",
  "sandboxNote": "print mode auto-approves every tool call; only the review prompt keeps it read-only",
  "resume": {
    "supported": true,
    "argv": [
      "kimi",
      "--quiet",
      "--work-dir",
      "{{worktree}}",
      "--session",
      "{{sessionId}}",
      "--prompt",
      "{{promptText}}"
    ],
    "idFrom": "session[ _-]?id[:=]?\\s*([0-9a-zA-Z-]{8,})"
  },
  "report": "whole",
  "expectSeconds": 400,
  "install": "uv tool install --python 3.13 kimi-cli",
  "docs": "https://github.com/MoonshotAI/kimi-cli"
}
