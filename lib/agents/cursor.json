{
  "name": "cursor",
  "product": "Cursor Agent CLI",
  "role": "reviewer",
  "enabled": false,
  "promptDelivery": "argv",
  "cwd": "worktree",
  "argv": [
    "cursor-agent",
    "-p",
    "--output-format",
    "text",
    "{{promptText}}"
  ],
  "judgeArgv": [
    "cursor-agent",
    "-p",
    "--output-format",
    "text",
    "--force",
    "{{promptText}}"
  ],
  "sandbox": "none",
  "sandboxNote": "print mode has access to all tools including write and bash; only the review prompt keeps it read-only",
  "resume": {
    "supported": true,
    "argv": [
      "cursor-agent",
      "-p",
      "--output-format",
      "text",
      "--resume",
      "{{sessionId}}",
      "{{promptText}}"
    ],
    "idFrom": "(?:chat|session)[ _-]?id[:=]?\\s*([0-9a-zA-Z-]{8,})"
  },
  "report": "whole",
  "expectSeconds": 400,
  "install": "curl https://cursor.com/install -fsS | bash",
  "docs": "https://cursor.com/cli"
}
