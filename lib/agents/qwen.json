{
  "name": "qwen",
  "product": "Qwen Code",
  "role": "reviewer",
  "enabled": false,
  "promptDelivery": "argv",
  "cwd": "worktree",
  "argv": [
    "qwen",
    "--approval-mode",
    "default",
    "--output-format",
    "json",
    "--exclude-tools",
    "Edit",
    "Write",
    "NotebookEdit",
    "Task",
    "--allowed-tools",
    "Bash(git diff *)",
    "Bash(git status*)",
    "Bash(git show *)",
    "Bash(git merge-base *)",
    "Bash(git log *)",
    "Bash(git rev-parse *)",
    "--session-id",
    "{{sessionId}}",
    "--prompt={{promptText}}"
  ],
  "judgeArgv": [
    "qwen",
    "--approval-mode",
    "yolo",
    "--output-format",
    "json",
    "--prompt={{promptText}}"
  ],
  "sandbox": "tools",
  "sandboxNote": "reviewer excludes edit/write/notebook/delegation tools and allows Git inspection in default approval mode; local configuration remains trusted",
  "newSession": true,
  "resume": {
    "supported": true,
    "argv": [
      "qwen",
      "--approval-mode",
      "default",
      "--output-format",
      "json",
      "--exclude-tools",
      "Edit",
      "Write",
      "NotebookEdit",
      "Task",
      "--allowed-tools",
      "Bash(git diff *)",
      "Bash(git status*)",
      "Bash(git show *)",
      "Bash(git merge-base *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "--resume",
      "{{sessionId}}",
      "--prompt={{promptText}}"
    ]
  },
  "report": "result-json",
  "expectSeconds": 400,
  "install": "npm install -g @qwen-code/qwen-code",
  "docs": "https://qwenlm.github.io/qwen-code-docs/en/users/features/headless/"
}
